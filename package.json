{
	"name": "n8n-nodes-liferay",
	"version": "1.0.7",
	"description": "n8n Node for Liferay",
	"license": "MIT",
	"author": {
		"name": "Christian Hofstätter",
		"email": "chrishof@sent.at"
	},
	"homepage": "https://github.com/ChrisHof/n8n-nodes-liferay",
	"repository": {
		"type": "git",
		"url": "https://github.com/ChrisHof/n8n-nodes-liferay.git"
	},
	"keywords": [
		"liferay",
		"n8n",
		"n8n-community-node-package"
	],
	"main": "index.js",
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"credentials": [
			"dist/credentials/LiferayBasicAuthApi.credentials.js",
			"dist/credentials/LiferayOAuth2Api.credentials.js"
		],
		"n8nNodesApiVersion": 1,
		"nodes": [
			"dist/nodes/Liferay/Liferay.node.js"
		],
		"strict": true
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"@typescript-eslint/parser": "^8.59.3",
		"eslint": "9.39.4",
		"gulp": "^5.0.1",
		"prettier": "^3.8.3",
		"typescript": "^5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
